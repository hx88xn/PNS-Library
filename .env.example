# PDAS deployment settings. Copy to .env and edit:
#
#   cp .env.example .env
#
# .env is gitignored, so it does not travel with a `git pull` — this file is
# the copy that does. Compose reads .env automatically; no --env-file needed.

# ── Secret ───────────────────────────────────────────────────────────────
# No default anywhere. The fallback compiled into config.py is the literal
# string "change-me-before-deployment", and anyone who has read this
# repository can forge a session token with it against a RESTRICTED corpus.
#
#   openssl rand -hex 32
#
# Changing it later invalidates every issued token — everyone signs in again.
PDAS_JWT_SECRET=

# ── Ports published on the host ──────────────────────────────────────────
# What a reverse proxy in front of this stack should forward to.
#   pn.srv650330.hstgr.cloud     → 127.0.0.1:7069
#   pn-be.srv650330.hstgr.cloud  → 127.0.0.1:7070
PDAS_FRONTEND_PORT=7069
PDAS_BACKEND_PORT=7070

# ── Where the browser sends API requests ─────────────────────────────────
# Baked into the JavaScript bundle at build time, so a change here needs
# `docker compose up -d --build` — a restart will not pick it up.
#
# Two working configurations:
#
#   1. Leave it EMPTY. Requests go to the page's own origin and nginx proxies
#      /api to the backend. One hostname, one certificate, no CORS, and the
#      backend never has to be reachable from the internet at all.
#
#   2. Set it to the backend's own hostname, below. Then pn-be must serve
#      HTTPS as well: a browser on an https: page refuses to call http:, and
#      the failure surfaces only in the console as a blocked request.
#
# Set to the separate backend host, as asked. Blank it out to fall back to (1).
PDAS_API_URL=https://pn-be.srv650330.hstgr.cloud

# ── CORS ─────────────────────────────────────────────────────────────────
# A JSON array — the setting is a list[str] and pydantic parses it as JSON.
# Only consulted when the page and the API are on different origins, i.e.
# when PDAS_API_URL above is set. Naming the frontend explicitly, rather than
# "*", stops any other page on the internet from driving this API.
PDAS_CORS_ORIGINS=["https://pn.srv650330.hstgr.cloud"]

# ── Models ───────────────────────────────────────────────────────────────
# Pulled by the ollama-pull service and used by the backend. Changing the
# embedding model invalidates the index: run `pdas reindex` afterwards.
PDAS_LLM_MODEL=qwen3.5:4b
PDAS_EMBED_MODEL=bge-m3

# How long one Ollama request may take. Raise this on a CPU-only box: ingest
# embeds 32 chunks per request and generation processes several thousand
# tokens of retrieved context, either of which can outrun 120s without a GPU.
# Model loading is exempt — it has its own 600s allowance in core/ollama.py.
PDAS_OLLAMA_TIMEOUT=120

# Context window, in tokens. Must hold the retrieved passages plus the answer.
# Also the second memory lever after the model itself, since the KV cache is
# sized from it: dropping to 8192 is how a larger model fits on a box that
# cannot hold it at 16384 — at the cost of how much of the corpus fits in a
# single prompt, which is what this application spends its budget on.
PDAS_NUM_CTX=16384

# ── Sessions ─────────────────────────────────────────────────────────────
# How long a sign-in lasts, in minutes.
#
# The shipped default is 15, deliberately short: the token survives a page
# reload now, so it is written down, and a written-down credential against a
# RESTRICTED corpus should be worth little for long.
#
# That suits a shared terminal. It does not suit someone reading a rulebook
# for an afternoon — there is no refresh, so every lapse costs a full
# sign-in. 480 (eight hours) survives a working day and still expires
# overnight. Raising it is a judgement about the room the terminal is in.
PDAS_JWT_TTL_MINUTES=480
