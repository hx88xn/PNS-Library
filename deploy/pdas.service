[Unit]
Description=PDAS — Platform Design Assistance System
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=pdas
Group=pdas
WorkingDirectory=/opt/pdas
EnvironmentFile=/opt/pdas/pdas.env
ExecStart=/opt/pdas/venv/bin/pdas serve
Restart=always
RestartSec=3

# Point HOME at the writable data directory. See ProtectHome below.
Environment="HOME=/opt/pdas/var"
Environment="XDG_CONFIG_HOME=/opt/pdas/var/config"
Environment="XDG_CACHE_HOME=/opt/pdas/var/cache"

# The corpus is RESTRICTED; keep the service away from everything else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/pdas/var

# tmpfs, not true. ProtectHome=true makes /home *inaccessible*, so a library
# that probes for a user config file at import time gets PermissionError and
# the service crash-loops before starting — ezdxf stats
# ~/.config/ezdxf/ezdxf.ini exactly this way. tmpfs mounts an empty /home
# instead, so the probe simply finds nothing. Same isolation, no false alarm.
ProtectHome=tmpfs
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
