[Unit]
Description=PDAS — Platform Design Assistance System
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=pdas
Group=pdas
WorkingDirectory=/opt/pdas
EnvironmentFile=/opt/pdas/pdas.env
ExecStart=/opt/pdas/venv/bin/pdas serve
Restart=always
RestartSec=3

# The corpus is RESTRICTED; keep the service away from everything else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pdas/var
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
